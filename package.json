{
  "name": "vue-parallaxy",
  "version": "2.0.0",
  "description": "Vue 3 component for parallax scrolling effects",
  "author": "Jakub Juszczak <jakub@posteo.de>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:apertureless/vue-parallax.git"
  },
  "bugs": {
    "url": "https://github.com/apertureless/vue-parallax/issues"
  },
  "homepage": "https://apertureless.github.io/vue-parallax/",
  "keywords": [
    "vue.js",
    "Vue",
    "vue3",
    "parallax",
    "scrolling",
    "image effect"
  ],
  "main": "./dist/vue-parallaxy.umd.cjs",
  "module": "./dist/vue-parallaxy.js",
  "unpkg": "./dist/vue-parallaxy.umd.cjs",
  "jsdelivr": "./dist/vue-parallaxy.umd.cjs",
  "exports": {
    ".": {
      "import": "./dist/vue-parallaxy.js",
      "require": "./dist/vue-parallaxy.umd.cjs"
    },
    "./style.css": "./dist/vue-parallaxy.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "unit": "vitest run",
    "test": "vitest run",
    "lint": "eslint src test",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/compiler-dom": "^3.5.22",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "vite": "^8.3.4",
    "vitest": "^4.0.8",
    "vue": "^3.5.22",
    "vue-eslint-parser": "^10.3.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
